# ==============================================================================
# Multi-Stage Research Agent Backend - Environment Configuration Example
# ==============================================================================

# Application Settings
PROJECT_NAME="Multi-Stage Research Agent Backend"
DEBUG=false
API_V1_PREFIX="/api"

# Database Configuration
# For PostgreSQL with pgvector (recommended for production/Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research_db
# For SQLite local development/testing (no Postgres install required):
DATABASE_URL=sqlite+aiosqlite:///./research.db
DATABASE_ECHO=false

# Provider Selection
# LLM_PROVIDER options: 'openai', 'gemini', 'claude', 'mock'
LLM_PROVIDER=mock

# SEARCH_PROVIDER options: 'tavily', 'brave', 'serper', 'duckduckgo', 'mock'
SEARCH_PROVIDER=duckduckgo

# LLM Provider API Keys & Settings
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Search Provider API Keys
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# Concurrency & Crawling Limits
MAX_CONCURRENT_REQUESTS=5
DEFAULT_NUMBER_OF_QUERIES=4
DEFAULT_INITIAL_SOURCES=8
DEFAULT_MAX_PAGES=20
DEFAULT_MAX_DEPTH=2
DEFAULT_MAX_PAGES_PER_DOMAIN=3
CRAWL_TIMEOUT_SECONDS=15
MAX_PAGE_SIZE_BYTES=5242880

# Dynamic JS Browser Crawling (Playwright)
ENABLE_PLAYWRIGHT_FALLBACK=false

# Vector Embeddings
EMBEDDING_DIM=1536
SIMILARITY_THRESHOLD_DEDUP=0.85
SIMILARITY_THRESHOLD_FOLLOWUP=0.65
